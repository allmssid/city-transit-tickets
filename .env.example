# Skopiuj do pliku .env i uzupełnij (plik .env NIE trafia do repo)
PORT=3000

# Ścieżka do pliku bazy SQLite (względem katalogu projektu)
DB_PATH=./data/database.sqlite

# Sekret do podpisywania tokenów JWT — wpisz długi, losowy ciąg
JWT_SECRET=185b4415cccbf38255668978dd5bff8582a6042003c8731e94789b610768221d
JWT_EXPIRES_IN=2h

# Adresy frontendu, z których API przyjmuje zapytania (po przecinku).
# Puste = dowolny adres (wygodne w trakcie developmentu).
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# Konto administratora tworzone przez `npm run db:seed`
ADMIN_EMAIL=admin@mpk.local
ADMIN_PASSWORD=Admin123!
